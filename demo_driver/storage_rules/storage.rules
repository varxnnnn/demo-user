// Firebase Storage Rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
  
  // Allow public read for uploaded images
  match /b/{bucket}/o/public/{allPaths=**} {
    allow read: if true;
  }
  
  // Allow authenticated users to upload to their own folders
  match /b/{bucket}/o/users/{userId}/{images=**} {
    allow read, write: if request.auth != null && request.auth.uid == userId;
  }
  
  // Allow authenticated users to upload to vehicle_images and rc_books folders
  match /b/{bucket}/o/vehicle_images/{imageId} {
    allow read, write: if request.auth != null;
  }
  
  match /b/{bucket}/o/rc_books/{imageId} {
    allow read, write: if request.auth != null;
  }
}
